{
  "name": "kjoreverk-server",
  "version": "0.1.0",
  "description": "Den sentrale serveren og databasen for kjøreverkene: mottak fra recorderne, historikk til HMI-ene, regler og web-side",
  "main": "server.js",
  "bin": {
    "kv-admin": "bin/kv-admin.js"
  },
  "scripts": {
