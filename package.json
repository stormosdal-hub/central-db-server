    "migrate": "node bin/kv-admin.js migrate",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "simulate": "node test/simulate.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fastify/static": "^8.1.0",
    "fastify": "^5.3.0",
    "pg": "^8.14.0"
  },
  "license": "MIT"
}
